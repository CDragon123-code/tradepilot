{
  "manifest_version": 3,
  "name": "外贸助手 · 员工工作台",
  "version": "0.32.0",
  "description": "智能客服接入 Dify 知识库，自动过滤思考过程，并拦截报价、交期、站外联系方式等高风险草稿。",
  "permissions": ["downloads", "scripting", "storage", "unlimitedStorage", "cookies", "alarms"],
  "host_permissions": [
    "https://*.alibaba.com/*",
    "https://alibaba.com/*",
    "https://message.alibaba.com/*",
    "https://onetalk.alibaba.com/*",
    "https://alicrm.alibaba.com/*",
    "https://i.alibaba.com/*",
    "https://data.alibaba.com/*",
    "https://mydata.alibaba.com/*",
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.openai.com/*",
    "https://open.bigmodel.cn/*",
    "https://api.dify.ai/*",
    "http://127.0.0.1:39271/*",
    "http://127.0.0.1:39272/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://message.alibaba.com/*",
        "https://onetalk.alibaba.com/*",
        "https://alicrm.alibaba.com/*",
        "https://i.alibaba.com/hub/alicrm/*",
        "https://biz.alibaba.com/*",
        "https://data.alibaba.com/*"
      ],
      "css": ["src/workbench.css"],
      "js": ["vendor/xlsx.full.min.js", "src/identity.js", "src/platform-job.js", "src/sync-state.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://i.alibaba.com/ads/*", "https://www2.alibaba.com/ads/*"],
      "js": ["src/ads-collector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "外贸助手 · 员工工作台"
  }
}
