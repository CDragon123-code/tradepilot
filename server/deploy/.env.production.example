# 服务地址与证书
DOMAIN=api.example.com

# PostgreSQL（密码建议只用字母数字，或用 DATABASE_URL 显式覆盖）
POSTGRES_DB=ali_cloud
POSTGRES_USER=ali
POSTGRES_PASSWORD=请改成强密码
DATABASE_URL=

# API 令牌（两类身份分开：采集只写、员工只读）
INGEST_TOKEN=请改成至少32位随机串
READ_TOKEN=请改成至少32位随机串
SELLER_ID=seller-main
# 多店铺白名单（逗号分隔）；留空则沿用 SELLER_ID 单店铺限制
SELLER_IDS=seller-main,seller-sub
# 采集器只采集这些店铺（逗号分隔）；留空表示采集所有已托管登录态的店铺
COLLECT_SELLERS=
TENANT_ID=default

# 巡检与询盘提醒（群机器人 webhook 优先；也可用自建应用三件套）
FEISHU_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# 智能业务员：全平台共用一套 Dify 知识库（在 Dify 后台复制应用 API Key）
SECRET_KEY=
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# 备份
TZ=Asia/Shanghai
BACKUP_DIR=./backups
OSS_BUCKET=
OSS_PREFIX=db
