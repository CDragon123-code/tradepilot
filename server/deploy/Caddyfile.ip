# 临时访问模式：域名备案未完成，使用 Caddy 内部 CA 自签证书
# 浏览器访问纯 IP 时不发送 SNI，必须用 default_sni 指定，否则握手会 internal error
{
	default_sni 203.0.113.10
}

# 通道一：公网 IP + 8443（备用，域名解析异常时仍可用）
https://203.0.113.10:8443 {
	tls internal
	encode gzip
	reverse_proxy api:8787

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
	}
}

# 通道二：域名 + 8443（备案完成前也走自签证书，无需 80/443）
https://api.example.com:8443 {
	tls internal
	encode gzip
	reverse_proxy api:8787

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
	}
}
